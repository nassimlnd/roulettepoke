# Reverse-proxy de prod. `envsubst` (entrypoint de l'image nginx) remplace
# ${API_TARGET} et ${API_HOST} au démarrage. Les variables nginx ($uri,
# $http_upgrade, $host…) ne sont pas dans l'environnement → restent littérales.
#
#   /api/    → backend (avec réécriture d'Origin, sinon 500) + upgrade WebSocket
#   /images/ → backend
#   /*       → serveur frontend Nuxt (service "web" du compose, port 3000)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen       80;
    server_name  _;

    # API (+ WebSocket du chat) : proxy backend AVEC réécriture d'Origin/Referer.
    location /api/ {
        proxy_pass            ${API_TARGET};
        proxy_ssl_server_name on;
        proxy_set_header      Host    ${API_HOST};
        proxy_set_header      Origin  ${API_TARGET};
        proxy_set_header      Referer ${API_TARGET}/;
        proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto $scheme;
        proxy_http_version    1.1;
        proxy_set_header      Upgrade    $http_upgrade;
        proxy_set_header      Connection $connection_upgrade;
        proxy_read_timeout    3600s;   # WebSocket long-vécu
    }

    # Sprites / badges / icônes de types servis par le backend.
    location /images/ {
        proxy_pass            ${API_TARGET};
        proxy_ssl_server_name on;
        proxy_set_header      Host ${API_HOST};
    }

    # Tout le reste : le serveur frontend Nuxt (sert le SPA + ses assets, gère
    # lui-même le routage côté client et le cache des assets fingerprintés).
    location / {
        proxy_pass         http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection $connection_upgrade;
    }
}
